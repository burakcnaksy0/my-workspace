# ==========================================
# Personal Workspace Environment Configuration
# ==========================================

# Database Configuration
POSTGRES_DB=personal_workspace
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_secure_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Security & Bootstrap Credentials
# Bootstrap credentials are used ONCE on initial startup if the users table is empty.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=workspace_admin_password_change_me
BOOTSTRAP_DEFAULT_WORKSPACE="Kişisel Çalışma Alanım"

# Session & Security Settings
SESSION_MAX_INACTIVE_INTERVAL_SECONDS=86400
SESSION_COOKIE_SECURE=false

# System & Timezone Settings
TZ=Europe/Istanbul

# Host Port Mappings
# Only port 3000 is exposed to localhost. Backend and DB are internal to docker network.
FRONTEND_PORT=3000
